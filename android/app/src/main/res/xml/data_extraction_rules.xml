<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup (local-only data). Device-to-device transfer keeps the user's forest when they change phone. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /></cloud-backup>
    <device-transfer><include domain="file" path="data.json" /></device-transfer>
</data-extraction-rules>
